{
  "name": "scync-cli",
  "version": "0.1.1",
  "description": "Zero-knowledge developer secrets manager with a full-screen terminal UI and CLI",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "scync": "bin/scync.js"
  },
  "files": [
    "dist",
    "bin",
    "README.md",
    "USER_GUIDE.md",
    "LICENSE",
    "CHANGELOG.md",
    "SECURITY.md"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsx src/cli/index.ts",
    "test": "vitest run",
    "test:emulator": "firebase emulators:exec --project demo-scync \"npx vitest run --config vitest.emulator.config.ts\"",
    "test:smoke": "node scripts/smoke-test.mjs",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "keywords": [
    "secrets",
    "secrets-manager",
    "zero-knowledge",
    "cli",
    "tui",
    "terminal",
    "encryption",
    "aes-256-gcm",
    "developer-tools",
    "security"
  ],
  "author": "Hariharen",
  "license": "MIT",
  "homepage": "https://scync.space",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hariharen9/Scync-cli.git"
  },
  "bugs": {
    "url": "https://github.com/hariharen9/Scync-cli/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "commander": "^12.1.0",
    "dotenv": "^16.4.5",
    "firebase": "^10.14.1",
    "open": "^10.1.0",
    "otpauth": "^9.6.0",
    "picocolors": "^1.1.1"
  },
  "devDependencies": {
    "@types/node": "^20.17.6",
    "tsup": "^8.3.5",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.4"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
