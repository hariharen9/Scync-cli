{
  "name": "scync-cli",
  "version": "0.1.0",
  "description": "Command-line client for Scync zero-knowledge secrets manager",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "scync": "bin/scync.js"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsx src/cli/index.ts",
    "test": "vitest run",
    "test:emulator": "firebase emulators:exec --project demo-scync \"npx vitest run --config vitest.emulator.config.ts\"",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "secrets",
    "zero-knowledge",
    "cli",
    "security"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "commander": "^12.1.0",
    "dotenv": "^16.4.5",
    "firebase": "^10.14.1",
    "open": "^10.1.0",
    "picocolors": "^1.1.1"
  },
  "devDependencies": {
    "@types/node": "^20.17.6",
    "tsup": "^8.3.5",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.4"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
